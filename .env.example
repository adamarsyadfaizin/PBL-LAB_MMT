# Konfigurasi database
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# Di Vercel, isi lewat Project Settings -> Environment Variables.

# Cara 1 (paling praktis untuk Neon): satu baris connection string
# DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Cara 2: isi terpisah
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_pbl
DB_USER=postgres
DB_PASSWORD=
# prefer untuk lokal, require untuk Neon/Supabase
DB_SSLMODE=prefer

# Tampilkan pesan error detail (matikan di server produksi)
APP_DEBUG=false
