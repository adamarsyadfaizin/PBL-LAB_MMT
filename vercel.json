{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/favicon.ico", "dest": "/assets/images/favicon.png" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/admin/assets/(.*)", "dest": "/admin/assets/$1" },
    { "src": "/menu/assets/(.*)", "dest": "/menu/assets/$1" },
    { "src": "/menu/components/(navbar|floating-profile)\\.css", "dest": "/menu/components/$1.css" },
    { "src": "/menu/components/(navbar|floating-profile)\\.js", "dest": "/menu/components/$1.js" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
